generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  USER
  PLATFORM
  PROVIDER
  ESCROW
}

enum PaymentStatus {
  CREATED
  PROCESSING
  SUCCEDDED
  FAILED 
  UNKNOWN
}

 enum OutboxEventType {
    PAYMENT_CREATED
    PAYMENT_SUCCEEDED
    PAYMENT_FAILED
    REFUND_CREATED
    REFUND_SUCCEEDED
    REFUND_FAILED
    LEDGER_POSTED
    RECONCILIATION_COMPLETED
  }

enum ProcessorAttempt {
  SUCCESS
  FAILED
  CREATED
  UNKNOWN
}

enum OutboxStatus {
    PENDING
    PUBLISHED
    FAILED
  }

enum TransactionType {
  PAYMENT
  REFUND
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RefundStatus {
  SUCCESS
  PROCESSING
  FAILED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  PAYPAL
}

model Account {
  id        String      @id @default(uuid())
  name      String
  type      AccountType
  currency  String
  createdAt DateTime    @default(now())

  ledgerEntries LedgerEntry[]
}

model Transaction {
  id          String            @id @default(uuid())
  externalRef String?           @unique
  type        TransactionType
  paymentId   String
  payment     Payment?     
  refund      Refund?
  status      TransactionStatus @default(PENDING)
  amount      Decimal
  currency    String
  createdAt   DateTime          @default(now())

  entries LedgerEntry[]
}

model LedgerEntry {
  id            String @id @default(uuid())
  transactionId String
  accountId     String

  debit  Decimal @default(0)
  credit Decimal @default(0)

  createdAt DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])
  account     Account     @relation(fields: [accountId], references: [id])

  @@index([transactionId])
  @@index([accountId])
}

model PaymentEvent {
  id              String          @id @default(uuid())
  provider        PaymentProvider
  externalEventId String          @unique
  idempotencyKey  String          @unique
  payload         Json
  status          String          @default("RECEIVED") // RECEIVED, PROCESSED, FAILED
  processed       Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@index([externalEventId])
}

model ReconciliationReport {
  id              String          @id @default(uuid())
  provider        PaymentProvider
  expectedBalance Decimal
  actualBalance   Decimal
  discrepancy     Decimal
  createdAt       DateTime        @default(now())
}


model Idempotency {
  key             String   @id
  requestPath     String
  requestBodyHash String
  responseStatus  Int?
  responseJson    Json?
  createdAt       DateTime @default(now())
  lockedAt        DateTime?
}

model Payment {
  id    String   @id @unique
  idempotencyKey  String   @unique
  amountMinor    Float  
  currency      String 
  provider      PaymentProvider
  status       PaymentStatus
  processingAttempts  ProcessorAttempt[]
  refunds         Refund[]
  ledgerTransactionId  String?         @unique
  ledgerTransaction    Transaction?    @relation(fields: [ledgerTransactionId], references: [id])
  createdAt            DateTime   @default(now())
  updatedAt            DateTime
}

model Refund {
  id             String      @id @unique @default(uuid())
  paymentId      String     
  payment        Payment   @relation(fields: [paymentId], references: [id])
  amountMinor    BigInt
  status         RefundStatus
  ledgerTransactionId     String?    @unique
  ledgerTransaction   Transaction?     @relation(fields: [ledgerTransactionId], references: [id])
  createdAt          DateTime
}


model OutboxEvent {
    id            String          @id @default(uuid())

    eventType     OutboxEventType
    aggregateType String
    aggregateId   String

    payload       Json

    status        OutboxStatus    @default(PENDING)
    attempts      Int             @default(0)
    availableAt   DateTime        @default(now())
    publishedAt   DateTime?
    lastError     String?

    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt

    @@index([status, availableAt])
    @@index([aggregateType, aggregateId])
    @@index([eventType, createdAt])
  }
